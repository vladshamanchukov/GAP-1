[Unit]
Description=VictoriaMetrics
After=network.target

[Service]
User=victoriametrics
Group=victoriametrics
ExecStart=/usr/local/bin/victoria-metrics \
    -storageDataPath=/var/lib/victoria-metrics \
    -retentionPeriod=14d \
    -httpListenAddr=:8428
Restart=on-failure

[Install]
WantedBy=multi-user.target
